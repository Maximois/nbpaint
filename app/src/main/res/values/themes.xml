<resources>
    <!-- NB-paint es siempre oscuro: el fondo oscuro evita el destello blanco
         al abrir la app y mantiene fiel el color con el que se está pintando. -->
    <style name="Theme.NBPaint" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nb_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
